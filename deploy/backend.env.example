# /etc/suprema/backend.env  (owner root, group gate, mode 0640)
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Required: every /api call carries it. Generate: openssl rand -hex 32
API_TOKEN=

# Local database on this gate PC
DATABASE_URL=mysql://suprema_local:CHANGE_ME@127.0.0.1:3306/suprema_local

# Shared cloud schema on the school server (TLS). One account per gate PC,
# pinned to this PC's public IP, with SELECT/INSERT and column UPDATE only.
CLOUD_DATABASE_URL=mysql://hikv_sync_gate1:CHANGE_ME@<school-db-host>:3306/hikv_person_ac?sslaccept=strict
CLOUD_SYNC_TRIGGER=both
CLOUD_SYNC_INTERVAL_MS=300000
# First swipe time this PC may push to the cloud: the install time of this
# version. Older local swipes are never re-sent (attendance history is immutable).
CLOUD_SYNC_EVENTS_SINCE=2026-11-01T00:00:00Z

# Device gateway on this PC
GATEWAY_IP=127.0.0.1
GATEWAY_PORT=4000
GATEWAY_SSL=true
GATEWAY_CA_FILE=/opt/suprema/device_gateway/cert/ca.crt

# Terminals follow the school zone (DST-aware). Use DEVICE_TIMEZONE=fixed plus
# DEVICE_TIMEZONE_OFFSET=<seconds> only to pin an offset.
DEVICE_TIMEZONE=Africa/Cairo

# What each terminal TNA key means here (work-hours report)
TNA_KEY_MAP=1=clock_in,2=clock_out

# Visitor QR codes on the terminals: enable only after the one-terminal trial
VISITOR_QR_PROVISIONING=false

# Startup never changes the schema; run `npx prisma migrate deploy` on upgrades
AUTO_SCHEMA_SYNC=false
