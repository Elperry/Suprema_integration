[Unit]
Description=Suprema BioStar device gateway (G-SDK)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gate
WorkingDirectory=/opt/suprema/device_gateway
ExecStart=/opt/suprema/device_gateway/device_gateway_linux_x64
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
